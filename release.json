      "status": 200,
      "contains": "<div id=\"root\""
    },
    {
      "path": "/api/config",
      "status": 200,
      "contains": "\"signInRequired\":true"
    },
    {
      "path": "/api/weather?lat=51.5&lon=-0.1",
      "status": 401
    },
    {
      "path": "/sitemap.xml",
      "status": 200,
      "contains": "<urlset"
    }
  ]
