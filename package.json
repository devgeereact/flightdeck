{
  "name": "flightdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"php -S 127.0.0.1:3001 php/dev-router.php\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-public.mjs",
    "test": "node scripts/with-local-test.mjs tsx --test test/*.test.ts test/*.test.mjs",
    "test:php": "node scripts/with-local-test.mjs php php/tests/run.php",
    "test:ui": "node scripts/with-local-test.mjs node test/ui-smoke.mjs",
    "test:console": "node scripts/with-local-test.mjs node test/console-smoke.mjs",
    "dev:live-account": "node scripts/local-live.mjs"
  },
  "dependencies": {
    "@clerk/react": "6.17.8",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.15.0"
}
