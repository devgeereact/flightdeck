{
  "name": "flightdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"php -S 127.0.0.1:3001 php/dev-router.php\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-public.mjs",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts test/*.test.ts test/*.test.mjs",
    "test:php": "php php/tests/run.php",
    "parity": "node php/tests/parity.mjs",
    "test:ui": "node test/ui-smoke.mjs",
    "dev:node": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\""
  },
  "dependencies": {
    "@clerk/react": "6.17.8",
    "@gsap/react": "2.1.2",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "gsap": "3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.15.0"
}
