# Copy to .env (gitignored). Values here stay EMPTY in this example file. Never use a VITE_ prefix for a secret.
# OpenSky Network OAuth2 API client (live aircraft position).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# AeroDataBox key from RapidAPI (schedule, gates, baggage). The server reads RAPID_API_KEY or AERODATABOX_KEY.
RAPID_API_KEY=
PORT=3001

# Clerk publishable key (public by design, safe in the browser; baked into the build). Leave empty to run without login.
VITE_CLERK_PUBLISHABLE_KEY=
