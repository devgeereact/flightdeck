{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flightdeck: Develop",
      "type": "shell",
      "command": "/opt/homebrew/bin/mise exec -- pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Flightdeck: Build",
      "type": "shell",
      "command": "/opt/homebrew/bin/mise exec -- pnpm build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Flightdeck: Test",
      "type": "shell",
      "command": "/opt/homebrew/bin/mise exec -- pnpm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Flightdeck: Production preview",
      "type": "shell",
      "command": "/opt/homebrew/bin/mise exec -- pnpm start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
