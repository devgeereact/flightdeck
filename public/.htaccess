# Flightdeck on cPanel/Apache. /api goes to the PHP entrypoint BEFORE the SPA fallback.
Options -Indexes

AddType application/manifest+json .webmanifest
RewriteEngine On

# Some hosts strip the Authorization header before PHP sees it; hand it through.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_URI} !^/api/index\.php$
RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# A missing file (ads.txt while ads are off, a stale asset) is a real 404, not the app shell.
RewriteRule \.(txt|xml|js|css|map|json|webmanifest|png|jpe?g|webp|gif|ico|svg|woff2?|pdf)$ - [R=404,L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Revalidate the shell, manifest and service worker so releases update; hashed assets can cache.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|consent\.js|manifest\.webmanifest|workbox-.*\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header setifempty Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header setifempty Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>
