# Flightdeck on cPanel/Apache. /api goes to the PHP entrypoint BEFORE the SPA fallback.
Options -Indexes

AddType application/manifest+json .webmanifest
RewriteEngine On

# Some hosts strip the Authorization header before PHP sees it; hand it through.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_URI} !^/api/index\.php$
RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# The app lives at "/" (hash routes). Clerk's own return paths still get the shell; anything else that is not a real file is a true 404.
RewriteRule ^(index\.html)?$ index.html [L]
RewriteRule ^(sso-callback|sign-in|sign-up|v1|__clerk)(/|$) index.html [L]
ErrorDocument 404 /404.html
RewriteRule ^ - [R=404,L]

<IfModule mod_headers.c>
  # Revalidate the shell, manifest and service worker so releases update; hashed assets can cache.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|consent\.js|manifest\.webmanifest|workbox-.*\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fingerprinted build output only (index-AbC123.js). Scripts with fixed names (sw, consent, page, contact...) must keep revalidating.
  <FilesMatch "^(?!(index|sw|registerSW|consent|page|contact|travel-checklist)\.js$|workbox-).*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS for this hostname only (no includeSubDomains, no preload), so sibling gakinz.com sites are unaffected.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Content-Security-Policy is enforced. It was run report-only first and the owner confirmed no violations on production sign-in.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.clerk.accounts.dev https://clerk.flightdeck.gakinz.com https://challenges.cloudflare.com https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://*.clerk.accounts.dev https://clerk.flightdeck.gakinz.com https://clerk-telemetry.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://cloudflareinsights.com; img-src 'self' data: https://img.clerk.com https://*.google-analytics.com https://*.googletagmanager.com https://www.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://challenges.cloudflare.com https://*.clerk.accounts.dev https://clerk.flightdeck.gakinz.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>
