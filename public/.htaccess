# Flightdeck on cPanel/Apache. /api -> PHP API; the public website -> site.php (pages rendered from CMS content); /app/ -> the app.
Options -Indexes
DirectoryIndex site.php

AddType application/manifest+json .webmanifest
RewriteEngine On

# Some hosts strip the Authorization header before PHP sees it; hand it through.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_URI} !^/api/index\.php$
RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

# Site pages BEFORE the real-file check: releases are additive, so the old static copies of these pages may still be on the server.
RewriteRule ^(index\.html)?$ site.php [L]
RewriteRule ^(about|contact|privacy|cookies|terms|travel-checklist|guides|help|coverage|how-it-works|accessibility)(/.*)?$ site.php [L]
RewriteRule ^(sitemap\.xml|ads\.txt|404\.html)$ site.php [L]
RewriteRule ^media/ site.php [L]

# The app: its own files are served as they are; anything else under /app/ gets the app shell (hash routes).
RewriteRule ^app$ /app/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^app/ app/index.html [L]
# Clerk's own return paths still get the app shell.
RewriteRule ^(sso-callback|sign-in|sign-up|v1|__clerk)(/|$) app/index.html [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
# Everything else is a site page the owner may have added in the console, or a true 404, which site.php renders.
RewriteRule ^ site.php [L]
ErrorDocument 404 /site.php

<IfModule mod_headers.c>
  # Revalidate the shell, manifest and service worker so releases update; hashed assets can cache.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|consent\.js|manifest\.webmanifest|site-build\.json|workbox-.*\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fingerprinted build output only (index-AbC123.js, site-AbC123.css). Scripts with fixed names (sw, consent, page, contact...) must keep revalidating.
  <FilesMatch "^(?!(index|sw|registerSW|consent|page|contact|travel-checklist)\.js$|workbox-).*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS for this hostname only (no includeSubDomains, no preload), so sibling gakinz.com sites are unaffected.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Clerk's abuse and fraud protection hosts (*.protect.clerk.com, any port for connect) added 31 Oct 2026 per Clerk's CSP guide;
  # without them the bootstrap script was refused on production sign-in.
  # Content-Security-Policy is enforced. It was run report-only first and the owner confirmed no violations on production sign-in.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://clerk.flightdeck.gakinz.com https://challenges.cloudflare.com https://*.protect.clerk.com https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://clerk.flightdeck.gakinz.com https://*.protect.clerk.com:* https://clerk-telemetry.com https://*.clerk-telemetry.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://cloudflareinsights.com; img-src 'self' data: https://img.clerk.com https://*.google-analytics.com https://*.googletagmanager.com https://www.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://challenges.cloudflare.com https://*.protect.clerk.com https://clerk.flightdeck.gakinz.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>
